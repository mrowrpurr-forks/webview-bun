{
  "name": "sweetview-webview-bun",
  "description": "Bun bindings for webview, a tiny library for creating web-based desktop GUIs. A fork of webview-bun whose shipped library adds webview_set_asset and webview_set_background_color.",
  "version": "2.5.0",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "files": [
    "src/",
    "build/"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "clean": "bun exec \"rm -rf webview/build\"",
    "pretty": "bunx --bun prettier . \"!webview/**\" --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0t-invented-here/sweetview-webview-bun.git"
  },
  "keywords": [
    "bun",
    "webview",
    "webview-bun",
    "sweetview"
  ],
  "author": "Mrowr Purr",
  "license": "MIT",
  "contributors": [
    "tr1ckydev (webview-bun)",
    "citkane",
    "WebReflection",
    "StrangeBytesDev"
  ],
  "bugs": {
    "url": "https://github.com/n0t-invented-here/sweetview-webview-bun/issues"
  },
  "homepage": "https://github.com/n0t-invented-here/sweetview-webview-bun#readme",
  "devDependencies": {
    "@types/bun": "latest"
  }
}
